{
  "info": {
    "name": "CampusReserve - Loans API (SCRUM-35)",
    "description": "Lab 6 CRUD tests for /api/loans. Run `npm run dev` in CampusReserve first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET /api/loans (List all)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": ["{{baseUrl}}"],
          "path": ["api", "loans"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/loans/1 (Retrieve by ID)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/loans/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "loans", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Loan has id 1\", function () {",
              "  pm.expect(pm.response.json()).to.have.property(\"id\", 1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/loans (Create valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reservationId\": 1,\n  \"managerId\": 2,\n  \"pickupTime\": \"2026-11-25T19:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": ["{{baseUrl}}"],
          "path": ["api", "loans"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Created loan has id and checked_out status\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property(\"id\");",
              "  pm.expect(json.status).to.eql(\"checked_out\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/loans (Missing field - 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"managerId\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": ["{{baseUrl}}"],
          "path": ["api", "loans"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Response contains error message\", function () {",
              "  pm.expect(pm.response.json()).to.have.property(\"error\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /api/loans/1 (Update)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"returned\",\n  \"condition\": \"intact\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/loans/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "loans", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Status updated to returned\", function () {",
              "  pm.expect(pm.response.json().status).to.eql(\"returned\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /api/loans/2 (Delete)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/loans/2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "loans", "2"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
